#!/bin/bash

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(cd -- "$SCRIPT_DIR/.." && pwd)"
export DIALOGRC="$PROJECT_ROOT/config/dialogrc"
APP_VERSION="0.4"
while true; do
opcion=$(dialog --title "ALEXANDRIA OS $APP_VERSION" \
  --backtitle "ALEXANDRIA OS $APP_VERSION  ///  ARCHIVO DOCUMENTAL" \
  --menu "Elegí una sección" 17 64 6 \
  1 "THE WORLD" \
  2 "THE COMIC ARCHIVE" \
  3 "THE REFUGE" \
  4 "CUADERNO DE CAMPO" \
  5 "MANUAL / AYUDA" \
  6 "TERMINAL" \
  3>&1 1>&2 2>&3)
 case "$opcion" in
   1) bash /home/walker/alexandria-os/src/world/menu.sh ;;
   2) bash /home/walker/alexandria-os/src/comic_archive/menu.sh ;;
   3) python3 "$PROJECT_ROOT/src/refuge/refuge.py" ;;
   4) nano /home/walker/alexandria-os/data/cuaderno.txt ;;
   5) dialog --msgbox "Flechas y Enter: recorrer y elegir. Escape: cancelar. Cuaderno: editar notas en Nano. Terminal: volver a consola. Las secciones principales siguen en desarrollo." 9 65 ;;

   6) break ;;
   *) break ;;
 esac
done

	
