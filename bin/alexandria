#!/bin/bash

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(cd -- "$SCRIPT_DIR/.." && pwd)"
APP_VERSION="0.6"
export ALEXANDRIA_ROOT="$PROJECT_ROOT"
export DIALOGRC="$PROJECT_ROOT/config/dialogrc"
if ! dialog --print-maxsize >/dev/null 2>&1; then
  unset DIALOGRC
fi

LOGO_FILE="$PROJECT_ROOT/assets/logo-alexandria-safe-zone.png"
while true; do
  python3 "$PROJECT_ROOT/src/ui/main_menu.py" "$LOGO_FILE"
  opcion=$?
  case "$opcion" in
    1) bash "$PROJECT_ROOT/src/world/menu.sh" ;;
    2) bash "$PROJECT_ROOT/src/comic_archive/menu.sh" ;;
    3) python3 "$PROJECT_ROOT/src/refuge/refuge.py" ;;
    4) nano "$PROJECT_ROOT/data/cuaderno.txt" ;;
    5)
      MANUAL="$PROJECT_ROOT/docs/manual_ayuda.txt"
      if [[ -r "$MANUAL" ]]; then
        dialog --title "MANUAL / AYUDA" --exit-label "Volver" --textbox "$MANUAL" 0 0
      else
        dialog --title "MANUAL / AYUDA" --msgbox "No se encontró el archivo del manual:\n$MANUAL" 8 68
      fi
      ;;
    6) break ;;
    *) break ;;
  esac
done
