#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(cd -- "$SCRIPT_DIR/.." && pwd)"
CONFIG_FILE="$PROJECT_ROOT/config/comandos.bash"
BASHRC="$HOME/.bashrc"
MARKER_START="# >>> Alexandria OS: comandos personalizados >>>"
MARKER_END="# <<< Alexandria OS: comandos personalizados <<<"

if [[ ! -f "$CONFIG_FILE" ]]; then
    printf 'No encuentro el archivo de comandos: %s\n' "$CONFIG_FILE" >&2
    exit 1
fi

touch "$BASHRC"

if grep -Fq "$MARKER_START" "$BASHRC"; then
    printf 'Los comandos de Alexandria OS ya están conectados en %s.\n' "$BASHRC"
    printf 'Cerrá y volvé a abrir la terminal, o ejecutá: source %s\n' "$BASHRC"
    printf 'Usá comandosalexandria para ver la lista completa.\n'
    exit 0
fi

printf -v CONFIG_PATH_SHELL '%q' "$CONFIG_FILE"
{
    printf '\n%s\n' "$MARKER_START"
    printf 'if [[ -f %s ]]; then\n' "$CONFIG_PATH_SHELL"
    printf '    source %s\n' "$CONFIG_PATH_SHELL"
    printf 'fi\n'
    printf '%s\n' "$MARKER_END"
} >> "$BASHRC"

printf 'Comandos de Alexandria OS agregados a %s.\n' "$BASHRC"
printf 'Activálos ahora con: source %s\n' "$BASHRC"
printf 'Usá comandosalexandria para ver la lista completa.\n'
